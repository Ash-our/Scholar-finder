# Local defaults. Copy to .env only when you need to override them.
SM_MONGO_URI=mongodb://127.0.0.1:27017
SM_MONGO_DATABASE=scholarshipmap
SM_KAFKA_BOOTSTRAP=127.0.0.1:9092
SM_KAFKA_TOPIC=scholarships.raw
SM_CHECKPOINT_DIR=data/checkpoints
SM_COLLECTOR_INTERVAL=21600
SM_REQUEST_DELAY=1
SM_SPARK_MASTER=local[2]
SM_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Optional: full Java 21 JDK, not the stripped JetBrains JBR.
# SM_JAVA_HOME=C:/path/to/jdk-21
